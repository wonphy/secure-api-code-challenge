{
  "name": "secure-api-code-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @secure-api/gateway --filter @secure-api/backend run dev",
    "dev:gateway": "pnpm --filter @secure-api/gateway run dev",
    "dev:backend": "pnpm --filter @secure-api/backend run dev",
    "build": "pnpm --filter @secure-api/contracts run build && pnpm --filter @secure-api/gateway --filter @secure-api/backend -r run build",
    "typecheck": "pnpm --filter @secure-api/contracts run typecheck && pnpm --filter @secure-api/gateway --filter @secure-api/backend -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "pnpm --filter @secure-api/contracts run build && pnpm --filter @secure-api/gateway --filter @secure-api/backend -r run test",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.ts",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@secure-api/contracts": "workspace:*",
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^30.5.2",
    "jose": "^6.2.12",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
