# HTTP listener for the private backend service.
# The Docker Compose deployment uses the default port internally.
PORT=3001

# JSON structured logging threshold.
LOG_LEVEL=info

# `identity-only` implements the challenge requirement: a gateway-verified
# identity may use the API. Set `permissions` only after configuring the
# gateway to inject a verified X-Verified-User-Permissions claim.
AUTHORIZATION_MODE=identity-only
