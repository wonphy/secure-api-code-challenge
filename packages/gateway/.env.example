# Network configuration
PORT=3000
BACKEND_URL=http://localhost:3001

# OIDC access-token validation. All three values are required together.
# Obtain the JWKS URL from the provider's OIDC discovery document.
JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
JWT_ISSUER=https://idp.example.com/
JWT_AUDIENCE=secure-api

# Set to debug temporarily to log safe authentication diagnostics. Tokens and
# claims are never logged.
LOG_LEVEL=info

# Local development fallback only. It is ignored unless NODE_ENV=development.
# Do not set it when JWT_* settings are used or in any deployed environment.
# DEV_GATEWAY_TOKEN=local-dev-token
# DEV_GATEWAY_USER=local-dev-user
