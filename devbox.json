{
  "packages": ["nodejs@22", "pnpm@10"],
  "env": {
    "NODE_ENV": "development"
  },
  "shell": {
    "scripts": {
      "dev": "pnpm dev",
      "build": "pnpm build",
      "lint": "pnpm lint",
      "lint:fix": "pnpm lint:fix",
      "format": "pnpm format",
      "check": "pnpm check",
      "test": "pnpm test",
      "simulate": "docker compose up --build --force-recreate --remove-orphans",
      "simulate:down": "docker compose down",
      "simulate:mtls": "sh scripts/setup-local-mtls.sh && docker compose -f compose.yaml -f compose.mtls.yaml up --build --force-recreate --remove-orphans",
      "simulate:mtls:down": "docker compose -f compose.yaml -f compose.mtls.yaml down",
      "test:mtls-handshake": "sh scripts/test-mtls-handshake-rejection.sh"
    }
  }
}
