{
  "packages": ["nodejs@22", "pnpm@10"],
  "env": {
    "NODE_ENV": "development"
  },
  "shell": {
    "scripts": {
      "lint": "pnpm lint",
      "lint:fix": "pnpm lint:fix",
      "format": "pnpm format",
      "check": "pnpm check",
      "test": "pnpm test",
      "client": "pnpm dev:client",
      "server": "docker compose up --build --force-recreate --remove-orphans",
      "server:down": "docker compose down"
    }
  }
}
